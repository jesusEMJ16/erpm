# SQL Server connection
# Settings > SQL Server Connection saves tmp/database_settings.json.
# When that JSON exists, it overrides these .env defaults.
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
SQLSERVER_HOST=localhost
SQLSERVER_PORT=
SQLSERVER_INSTANCE=
SQLSERVER_DATABASE=EMINENTERP
SQLSERVER_SCHEMA=erp
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=change-me

# Security and transport
SQLSERVER_TRUSTED_CONNECTION=false
SQLSERVER_ENCRYPT=true
SQLSERVER_TRUST_SERVER_CERTIFICATE=true
SQLSERVER_CONNECTION_TIMEOUT=30
